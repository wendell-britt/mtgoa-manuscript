@@ -0,0 +1,260 @@
+/**
+ * Resend Audiences client — the one place this project talks to an ESP.
+ *
+ * Replaces `kit.ts`, which was written first and never switched on: production
+ * logged `[kit] not configured (KIT_API_KEY missing) — skipped sync` on every
+ * lead while the Resend send in the same request went through. One provider
+ * that works beats two where only one is wired.
+ *
+ * The mapping from the Kit design, since the vocabularies differ:
+ *
+ *   Kit tag              →  Resend segment      (resolved by name, created if absent)
+ *   Kit custom field     →  Resend contact property
+ *   Kit subscriber       →  Resend contact
+ *
+ * Everything else is deliberately unchanged. Same exported name and same input
+ * shape, so the six call sites do not move. Never throws and never rejects:
+ * callers save their own record first, then call `syncSubscriber` and tolerate a
+ * non-ok result. A flaky provider must not 500 a quiz submission or lose the
+ * lead — the lead is already in our database, and the ESP is a copy.
+ *
+ * Not configured is a normal state, not an error. Local, preview and CI all run
+ * without `RESEND_API_KEY` and get `{ ok: true, skipped: true }`.
+ *
+ * Who is allowed into a sequence is decided by `list-contract.ts`, not here.
+ * That file is pure and provider-agnostic on purpose, which is why swapping the
+ * provider left the backer promise untouched.
+ */
+import { getResend } from '@/lib/email/resend'
+import {
+  crossQuizTags,
+  decideSequenceTags,
+  type SequenceDecision,
+} from './list-contract'
+
+const TIMEOUT_MS = 8_000
+
+export type SubscriberSyncInput = {
+  email: string
+  firstName?: string | null
+  /** Data tags for this event. Sequence triggers are filtered by the contract. */
+  tags: readonly string[]
+  /** Contact properties, keyed by label. Missing properties are created. */
+  fields?: Record<string, string>
+}
+
+export type SubscriberSyncResult =
+  | {
+      ok: true
+      skipped?: false
+      contactId: string
+      created: boolean
+      tagsApplied: string[]
+      withheld: SequenceDecision['withheld']
+    }
+  | { ok: true; skipped: true; reason: string }
+  | { ok: false; error: string }
+
+/** Back-compat alias so the Kit-era type name keeps resolving. */
+export type KitSyncInput = SubscriberSyncInput
+
+type Client = NonNullable<ReturnType<typeof getResend>>
+
+/**
+ * The SDK takes no per-call signal, so the deadline lives here. A hung ESP call
+ * would otherwise hold a server action open well past the point the visitor has
+ * given up on it.
+ */
+async function withTimeout<T>(label: string, work: Promise<T>): Promise<T> {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  try {
+    return await Promise.race([
+      work,
+      new Promise<never>((_resolve, reject) => {
+        timer = setTimeout(() => reject(new Error(`${label} timed out after ${TIMEOUT_MS}ms`)), TIMEOUT_MS)
+      }),
+    ])
+  } finally {
+    if (timer) clearTimeout(timer)
+  }
+}
+
+/**
+ * Segment name → id, resolved once per process. The segment list is small and
+ * stable, and every quiz submission would otherwise pay for the same lookup.
+ */
+let segmentCache: Map<string, string> | null = null
+/** Property keys known to exist. Same reasoning as the segment cache. */
+let propertyCache: Set<string> | null = null
+
+/** Exposed so a long-lived process picks up segments created in the dashboard. */
+export function clearAudienceCache(): void {
+  segmentCache = null
+  propertyCache = null
+}
+
+async function loadSegments(resend: Client): Promise<Map<string, string>> {
+  if (segmentCache) return segmentCache
+  const cache = new Map<string, string>()
+  const res = await withTimeout('segments.list', resend.segments.list())
+  for (const segment of res.data?.data ?? []) {
+    if (segment.name) cache.set(segment.name, segment.id)
+  }
+  segmentCache = cache
+  return cache
+}
+
+async function resolveSegmentId(name: string, resend: Client): Promise<string | null> {
+  const cache = await loadSegments(resend)
+  const cached = cache.get(name)
+  if (cached) return cached
+
+  const created = await withTimeout('segments.create', resend.segments.create({ name }))
+  if (created.error || !created.data) {
+    // A concurrent submission may have created it between our read and write.
+    clearAudienceCache()
+    const refreshed = await loadSegments(resend)
+    return refreshed.get(name) ?? null
+  }
+  cache.set(name, created.data.id)
+  return created.data.id
+}
+
+/**
+ * Resend rejects a property value whose key has not been declared, so the keys
+ * are ensured before any contact write. Kit created fields implicitly; this is
+ * the one place the swap costs an extra call, and the cache makes it once.
+ */
+async function ensureProperties(keys: string[], resend: Client): Promise<void> {
+  if (keys.length === 0) return
+  if (!propertyCache) {
+    const known = new Set<string>()
+    const res = await withTimeout('contactProperties.list', resend.contactProperties.list())
+    for (const property of res.data?.data ?? []) {
+      if (property.key) known.add(property.key)
+    }
+    propertyCache = known
+  }
+  for (const key of keys) {
+    if (propertyCache.has(key)) continue
+    // Declared as a string because `fields` is Record<string, string> — the input
+    // type is what makes that safe, so widen the type here only if you widen it
+    // there. A duplicate is harmless: the key exists either way, which is all the
+    // caller needs. Losing the race is not a failure.
+    await withTimeout(
+      'contactProperties.create',
+      resend.contactProperties.create({ key, type: 'string' }),
+    )
+    propertyCache.add(key)
+  }
+}
+
+type ExistingContact = { id: string; segments: string[] } | null
+
+async function findContact(email: string, resend: Client): Promise<ExistingContact> {
+  const found = await withTimeout('contacts.get', resend.contacts.get({ email }))
+  if (found.error || !found.data) return null
+
+  const segments = await withTimeout('contacts.segments.list', resend.contacts.segments.list({ email }))
+  return {
+    id: found.data.id,
+    segments: (segments.data?.data ?? []).map((segment) => segment.name).filter(Boolean),
+  }
+}
+
+function dedupe(values: readonly string[]): string[] {
+  return [...new Set(values)]
+}
+
+/**
+ * Create or update a contact and apply its segments.
+ *
+ * Retaking a quiz updates the properties and adds the new data segments. It does
+ * not duplicate the contact and does not re-trigger a sequence — see
+ * `decideSequenceTags`.
+ */
+export async function syncSubscriber(input: SubscriberSyncInput): Promise<SubscriberSyncResult> {
+  const resend = getResend()
+  const email = input.email.trim().toLowerCase()
+  if (!email) return { ok: false, error: 'empty email' }
+
+  if (!resend) {
+    console.warn(`[esp] not configured (RESEND_API_KEY/EMAIL_FROM missing) — skipped sync for ${email}`)
+    return { ok: true, skipped: true, reason: 'esp_not_configured' }
+  }
+
+  try {
+    const existing = await findContact(email, resend)
+
+    // Cross-quiz marker needs to know what they already carry.
+    const desiredTags = [
+      ...input.tags,
+      ...crossQuizTags({ desiredTags: input.tags, existingTags: existing?.segments ?? [] }),
+    ]
+
+    const decision = decideSequenceTags({
+      desiredTags,
+      existingTags: existing?.segments ?? [],
+      isNewSubscriber: !existing,
+    })
+
+    const fields = input.fields ?? {}
+    const propertyKeys = Object.keys(fields)
+    await ensureProperties(propertyKeys, resend)
+    const properties = propertyKeys.length ? fields : undefined
+
+    let contactId: string
+    if (existing) {
+      const updated = await withTimeout(
+        'contacts.update',
+        resend.contacts.update({
+          email,
+          ...(input.firstName ? { firstName: input.firstName } : {}),
+          ...(properties ? { properties } : {}),
+        }),
+      )
+      if (updated.error) return { ok: false, error: `resend contacts.update -> ${updated.error.message}` }
+      contactId = existing.id
+    } else {
+      const created = await withTimeout(
+        'contacts.create',
+        resend.contacts.create({
+          email,
+          ...(input.firstName ? { firstName: input.firstName } : {}),
+          ...(properties ? { properties } : {}),
+        }),
+      )
+      if (created.error || !created.data) {
+        return {
+          ok: false,
+          error: `resend contacts.create -> ${created.error?.message ?? 'no contact id returned'}`,
+        }
+      }
+      contactId = created.data.id
+    }
+
+    const applied: string[] = []
+    for (const name of dedupe(decision.tags)) {
+      if (existing?.segments.includes(name)) continue
+      const segmentId = await resolveSegmentId(name, resend)
+      if (!segmentId) continue
+      const added = await withTimeout(
+        'contacts.segments.add',
+        resend.contacts.segments.add({ email, segmentId }),
+      )
+      if (!added.error) applied.push(name)
+    }
+
+    return {
+      ok: true,
+      contactId,
+      created: !existing,
+      tagsApplied: applied,
+      withheld: decision.withheld,
+    }
+  } catch (err) {
+    const reason = err instanceof Error ? err.message : String(err)
+    console.error('[esp] sync failed', { email, reason })
+    return { ok: false, error: `resend sync -> ${reason}` }
+  }
+}
